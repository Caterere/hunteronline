[node name="HeatmapHelpLabel" type="RichTextLabel" parent="MainContainer/VBox/TabContainer/8. Heatmap/HeatmapVBox"]
layout_mode = 2
size_flags_vertical = 3
bbcode_enabled = true
text = "[color=#00e1ff][b]GUIA DO MAPA DE CALOR (HEATMAP):[/b][/color]
• [color=#ff3333]💀 Zonas Mortas (Vazias):[/color] Setores onde nenhum NPC, Monstro, Evento ou POI existe.
• [color=#3388ff]🔵 Camada de NPCs:[/color] Mapeia a densidade da população urbana e vilas.
• [color=#ff5555]🔴 Camada PvE:[/color] Mapeia o perigo de monstros e zonas de combate.
• [color=#ffdd00]🟡 Camada de Eventos:[/color] Mapeia áreas com encontros dinâmicos e eventos mundiais.
• [color=#00ff88]🟢 Camada de Descobertas:[/color] Mapeia baús, segredos, glifos Gyo e barreiras Ko.

Atalho rápido para ligar/desligar durante o jogo: [b]F4[/b]."

