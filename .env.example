# ============================================================
# Hunter Online — variáveis locais (NÃO COMMITAR)
# ============================================================
# Copie este arquivo para `.env` e preencha o token. O `.env` está no
# .gitignore. Depois rode: bash scripts/tools/setup_mcp_local.sh
# para gerar os arquivos de configuração do MCP (também gitignored).

# Token da API do PixelLab MCP (https://api.pixellab.ai/mcp)
PIXELLAB_API_TOKEN=YOUR_API_TOKEN
